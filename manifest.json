{
  "manifest_version": 3,
  "name": "幕布增强：可选字体 + 平滑滚动/缩放",
  "version": "1.2.1",
  "description": "mubu.com / imubu.com 及其子域名：全局字体可从已安装字体中自选；思维导图平滑平移 / 平滑缩放。",
  "permissions": [
    "storage",
    "fontSettings"
  ],
  "action": {
    "default_title": "幕布字体与滚动设置",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mubu.com/*",
        "https://*.mubu.com/*",
        "https://imubu.com/*",
        "https://*.imubu.com/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://mubu.com/*",
        "https://*.mubu.com/*",
        "https://imubu.com/*",
        "https://*.imubu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
